# ESP32 -> ingest endpoint
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
ISG_DEVICE_ID=heatpump-main
ISG_INGEST_TOKEN=replace-with-device-token

# Supabase Edge Functions automatically provide SUPABASE_SECRET_KEYS as a JSON
# dictionary. ISG_SECRET_KEY_NAME optionally selects an entry (default: default).
# ISG_SECRET_KEY_NAME=default

# Grafana datasource
# For an IPv4-only Grafana host, use the Supabase shared session pooler.
# Copy the exact host from Dashboard -> Connect -> Session pooler.
# A custom role uses the pooler username ROLE.PROJECT_REF, for example
# grafana_hems.zocxinsxtfudedtvozkf.
SUPABASE_DB_HOST=replace-with-session-pooler-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=grafana_hems.zocxinsxtfudedtvozkf
SUPABASE_DB_PASSWORD=replace-with-readonly-password
