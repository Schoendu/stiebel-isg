# ESP32 -> ingest endpoint
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
ISG_DEVICE_ID=heatpump-main
ISG_INGEST_TOKEN=replace-with-device-token

# Server-side only. Use a current Supabase secret key (sb_secret_...).
# Never expose this value to browser clients or firmware source.
SUPABASE_SECRET_KEYS=replace-with-supabase-secret-key

# Grafana datasource
SUPABASE_DB_HOST=replace-with-database-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=replace-with-readonly-user
SUPABASE_DB_PASSWORD=replace-with-readonly-password
