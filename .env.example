# ESP32 -> ingest endpoint
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
ISG_DEVICE_ID=heatpump-main
ISG_INGEST_TOKEN=replace-with-device-token

# Server-side only. Never expose to browser clients or firmware source.
ISG_SECRET_KEY_NAME=default
default=replace-with-sb-secret-key

# Grafana datasource
SUPABASE_DB_HOST=replace-with-database-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=replace-with-readonly-user
SUPABASE_DB_PASSWORD=replace-with-readonly-password
