# ESP32 -> ingest endpoint
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
ISG_DEVICE_ID=heatpump-main
ISG_INGEST_TOKEN=replace-with-device-token

# Server-side only. Supabase exposes secret keys as a JSON dictionary.
# Select a named entry rather than sending this JSON value as an API key.
SUPABASE_SECRET_KEYS={"default":"sb_secret_replace-with-secret-key"}
SUPABASE_SECRET_KEY_NAME=default

# Grafana datasource
SUPABASE_DB_HOST=replace-with-database-host
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=replace-with-readonly-user
SUPABASE_DB_PASSWORD=replace-with-readonly-password
