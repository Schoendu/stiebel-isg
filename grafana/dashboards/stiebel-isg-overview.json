      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "stiebel-supabase"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  timestamp AS time,\n  outside_temperature_c AS \"Outside\",\n  heatpump1_flow_c AS \"WP flow\",\n  heatpump1_return_c AS \"WP return\",\n  CASE\n    WHEN COALESCE(heatpump1_flowrate_lmin, 0) > 0\n     AND COALESCE(heatpump1_delta_t_k, 0) > 0\n    THEN heatpump1_delta_t_k\n    ELSE NULL\n  END AS \"WP ΔT\"\nFROM public.measurements\nWHERE $__timeFilter(timestamp)\n  AND device_id = ${device:sqlstring}\nORDER BY timestamp",
          "refId": "A"
        }
      ],
      "description": "Heat-pump-side flow/return temperatures with outside temperature. ΔT is shown only while WP flow is present, to avoid idle/stagnation artefacts."
