      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "stiebel-supabase"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, CASE WHEN COALESCE(heatpump1_flowrate_lmin, 0) > 0 THEN GREATEST(COALESCE(heatpump1_delta_t_k, 0), 0) ELSE 0 END AS value FROM public.measurements WHERE device_id = ${device:sqlstring} ORDER BY timestamp DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "description": "Heat-pump-side spread: WP flow (register 543) minus WP return (542). Displayed as 0 K when the measured WP flow rate is zero."
    },
    {
      "id": 3,
