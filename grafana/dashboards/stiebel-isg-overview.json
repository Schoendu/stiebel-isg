          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "kwatt",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "stiebel-supabase"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT timestamp AS time, CASE WHEN compressor1 IS TRUE AND COALESCE(heatpump1_flowrate_lmin,0) > 0 AND COALESCE(heatpump1_delta_t_k,0) > 0 THEN thermal_power_kw WHEN compressor1 IS FALSE THEN 0 ELSE NULL END AS value FROM public.measurements WHERE device_id = ${device:sqlstring} ORDER BY timestamp DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "description": "Derived hydraulic heat-pump output: 0.998 × 4.186 / 60 × WP flow rate × (WP flow − WP return). Negative/idle artefacts are suppressed. This is WP-side output, not house-side radiator output."
    },
